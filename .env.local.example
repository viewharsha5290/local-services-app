# Copy this file to .env.local and fill in the values from your Supabase project's
# Settings -> API page. The anon key is safe to expose client-side; Row Level Security
# policies (see supabase/schema.sql) are what actually gate access.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only: used by scripts/import-google-places.mjs, never shipped to the browser ──
# Google Cloud console -> APIs & Services: enable "Places API (New)", create an API key,
# and restrict it to that API.
GOOGLE_PLACES_API_KEY=
# Supabase Settings -> API -> service_role. Bypasses Row Level Security — never prefix
# this with NEXT_PUBLIC_ and never paste it anywhere public.
SUPABASE_SERVICE_ROLE_KEY=
